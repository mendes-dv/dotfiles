{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
      "Better Auth": {
          "type": "remote",
          "url": "https://mcp.chonkie.ai/better-auth/better-auth-builder/mcp",
          "enabled": true,
      },
      "svelte": {
        "type": "local",
        "command": ["npx", "-y", "@sveltejs/mcp"],
        "enabled": true
      },
      "polar": {
        "type": "local",
        "command": ["npx", "mcp-remote", "https://mcp.polar.sh/mcp/polar-mcp"],
        "enabled": true
      },
      "medusa": {
        "type": "remote",
        "url": "https://mcp.chonkie.ai/better-auth/better-auth-builder/mcp",
        "enabled": true
      }
  }
}
